# Copy to .env and fill in. .env is gitignored; never commit real values.
# Placeholders only.

# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=your-youtube-api-key

# Groq API key (console.groq.com -> API Keys); used by the filter, tagger and research assistant
GROQ_API_KEY=your-groq-api-key

# Apify API token (console.apify.com -> Settings -> Integrations); used by the Reddit collector
APIFY_TOKEN=your-apify-token

# Password for the dashboard's administrator view (review notes, failures, logs)
ADMIN_PASSWORD=choose-a-strong-password
